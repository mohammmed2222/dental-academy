<%- include('../partials/header') %>
<main class="flex-grow max-w-container-max mx-auto w-full p-margin-mobile md:p-margin-desktop flex flex-col gap-6">
  <div class="flex items-center gap-4">
    <a href="/cohorts" class="flex items-center gap-1 text-on-surface-variant hover:text-on-surface transition-colors font-label-lg text-label-lg">
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
      <span>العودة</span>
    </a>
  </div>
  <h1 class="font-headline-md text-headline-md text-on-surface"><%= cohort ? 'تعديل المجموعة' : 'إضافة مجموعة جديدة' %></h1>

  <% if (error) { %>
  <div class="flex items-center gap-2 bg-error-container text-on-error-container p-3 rounded font-body-md text-body-md">
    <span class="material-symbols-outlined text-sm">error</span>
    <span><%= error %></span>
  </div>
  <% } %>

  <form action="<%= cohort ? '/cohorts/' + cohort.id + '/edit' : '/cohorts/create' %>" method="POST" class="bg-surface-container-lowest border border-outline-variant rounded p-6 flex flex-col gap-5 max-w-2xl">
    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface" for="name">اسم المجموعة</label>
      <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" dir="rtl" id="name" name="name" value="<%= cohort ? cohort.name : '' %>" required/>
    </div>

    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface" for="description">الوصف</label>
      <textarea class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md min-h-[80px]" dir="rtl" id="description" name="description"><%= cohort ? cohort.description : '' %></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="start_date">تاريخ البداية</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" id="start_date" name="start_date" type="date" value="<%= cohort ? cohort.start_date : '' %>"/>
      </div>
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="end_date">تاريخ النهاية</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" id="end_date" name="end_date" type="date" value="<%= cohort ? cohort.end_date : '' %>"/>
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface">الطلاب</label>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 max-h-48 overflow-y-auto bg-surface border border-outline-variant rounded p-3">
        <% students.forEach(function(s) { %>
        <label class="flex items-center gap-2 cursor-pointer font-body-md text-body-md text-on-surface hover:bg-surface-container-highest p-1 rounded">
          <input type="checkbox" name="student_ids" value="<%= s.id %>" <%= selectedStudents.indexOf(s.id) !== -1 ? 'checked' : '' %>/>
          <span><%= s.name %> (<%= s.email %>)</span>
        </label>
        <% }); %>
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface">الكورسات</label>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 max-h-48 overflow-y-auto bg-surface border border-outline-variant rounded p-3">
        <% courses.forEach(function(c) { %>
        <label class="flex items-center gap-2 cursor-pointer font-body-md text-body-md text-on-surface hover:bg-surface-container-highest p-1 rounded">
          <input type="checkbox" name="course_ids" value="<%= c.id %>" <%= selectedCourses.indexOf(c.id) !== -1 ? 'checked' : '' %>/>
          <span><%= c.title %></span>
        </label>
        <% }); %>
      </div>
    </div>

    <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity flex items-center justify-center gap-2 self-start">
      <span class="material-symbols-outlined text-sm"><%= cohort ? 'save' : 'add' %></span>
      <span><%= cohort ? 'حفظ التغييرات' : 'إنشاء المجموعة' %></span>
    </button>
  </form>
</main>
<%- include('../partials/footer') %>
