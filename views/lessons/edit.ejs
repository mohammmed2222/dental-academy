<%- include('../partials/header', { dashboardHeader: true }) %>
<%- include('../partials/back-button') %>



<main class="flex-1 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop py-8">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <h1 class="font-headline-lg text-headline-lg text-on-surface">تعديل الدرس</h1>
      <p class="font-body-lg text-body-lg text-secondary">تحديث محتوى الدرس</p>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 shadow-sm">
      <form action="/lessons/<%= lesson.id %>/edit" method="POST" enctype="multipart/form-data" class="space-y-5">
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="title">عنوان الدرس</label>
          <input type="text" id="title" name="title" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= lesson.title %>" required/>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="content">محتوى الدرس</label>
          <textarea id="content" name="content" rows="10" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" required><%= lesson.content %></textarea>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">نوع الدرس</label>
          <div class="flex items-center gap-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="type" value="text" <%= lesson.type === 'text' || !lesson.type ? 'checked' : '' %> class="text-primary focus:ring-primary"/> <span class="font-body-md">نص</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="type" value="video" <%= lesson.type === 'video' ? 'checked' : '' %> class="text-primary focus:ring-primary"/> <span class="font-body-md">فيديو</span>
            </label>
          </div>
        </div>
        <% if (lesson.video_url && !lesson.video_url.startsWith('http')) { %>
        <div class="bg-surface-container rounded p-3">
          <p class="font-label-lg text-label-lg text-on-surface mb-1">الفيديو الحالي</p>
          <video class="w-full max-h-48 rounded" controls><source src="<%= lesson.video_url %>" type="video/mp4"/></video>
          <input type="hidden" name="video_url" value="<%= lesson.video_url %>"/>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">تغيير الفيديو (اختياري)</label>
          <input type="file" id="video_file" name="video_file" accept="video/mp4,video/webm,video/ogg,video/quicktime" class="w-full bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md text-body-md file:bg-primary-container file:text-on-primary file:border-0 file:rounded file:py-2 file:px-4 file:font-label-lg file:ml-3 hover:file:opacity-90 transition-colors"/>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">اتركه فارغاً للاحتفاظ بالفيديو الحالي</p>
        </div>
        <% } else { %>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">رفع فيديو من الجهاز</label>
          <input type="file" id="video_file" name="video_file" accept="video/mp4,video/webm,video/ogg,video/quicktime" class="w-full bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md text-body-md file:bg-primary-container file:text-on-primary file:border-0 file:rounded file:py-2 file:px-4 file:font-label-lg file:ml-3 hover:file:opacity-90 transition-colors"/>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">صيغ مدعومة: mp4, webm, ogg, mov (الحد الأقصى 200MB)</p>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">أو رابط فيديو (YouTube)</label>
          <input type="url" id="video_url" name="video_url" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= lesson.video_url && lesson.video_url.startsWith('http') ? lesson.video_url : '' %>" placeholder="https://www.youtube.com/watch?v=..."/>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">يمكنك لصق رابط YouTube عادي وسيتم تحويله تلقائياً</p>
        </div>
        <% } %>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="duration">المدة (دقائق) - اختياري</label>
          <input type="number" id="duration" name="duration" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= lesson.duration || '' %>"/>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="release_date">تاريخ النشر (اختياري)</label>
          <input type="datetime-local" id="release_date" name="release_date" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= lesson.release_date ? lesson.release_date.substring(0, 16) : '' %>"/>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">اتركه فارغاً للنشر الفوري. إذا حددت تاريخاً، لن يظهر الدرس للطلاب إلا بعد هذا التاريخ.</p>
        </div>

        <details class="border-t border-outline-variant pt-6 mt-6 group" <%= typeof quiz !== 'undefined' && quiz ? 'open' : '' %>>
          <summary class="font-headline-md text-headline-md text-on-surface cursor-pointer list-none flex items-center gap-2 select-none">
            <span class="material-symbols-outlined text-primary group-open:rotate-180 transition-transform">expand_more</span>
            <%= typeof quiz !== 'undefined' && quiz ? 'تعديل اختبار الدرس' : 'إضافة اختبار للدرس (اختياري)' %>
          </summary>
          <div class="mt-4 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="quiz_title">عنوان الاختبار</label>
                <input type="text" id="quiz_title" name="quiz_title" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= typeof quiz !== 'undefined' && quiz ? quiz.title : '' %>" placeholder="اختبار: عنوان الدرس"/>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="quiz_passing_score">نسبة النجاح (%)</label>
                  <input type="number" id="quiz_passing_score" name="quiz_passing_score" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= typeof quiz !== 'undefined' && quiz ? quiz.passing_score : 60 %>" min="0" max="100"/>
                </div>
                <div>
                  <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="quiz_time_limit">الوقت (دقائق)</label>
                  <input type="number" id="quiz_time_limit" name="quiz_time_limit" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" value="<%= typeof quiz !== 'undefined' && quiz ? (quiz.time_limit || 0) : 0 %>" min="0"/>
                </div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="font-label-lg text-label-lg text-on-surface">الأسئلة</span>
                <button type="button" onclick="addQuestion()" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-1.5 px-3 rounded hover:opacity-90 transition-opacity flex items-center gap-1 text-sm">
                  <span class="material-symbols-outlined text-[16px]">add</span>
                  إضافة سؤال
                </button>
              </div>
              <div id="questionsContainer" class="space-y-3"></div>
              <p id="noQuestions" class="font-body-md text-body-md text-on-surface-variant text-center py-4">لم يتم إضافة أي أسئلة. اتركه فارغاً لحذف الاختبار.</p>
            </div>
          </div>
        </details>

        <div class="flex items-center gap-4 pt-4">
          <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-8 rounded hover:opacity-90 transition-opacity">حفظ التغييرات</button>
          <a href="/lessons/<%= lesson.id %>" class="border border-outline-variant text-secondary font-label-lg text-label-lg py-3 px-8 rounded hover:bg-surface-container-low transition-colors">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
let questionCount = 0;

<% if (typeof quizQuestions !== 'undefined' && quizQuestions && quizQuestions.length > 0) { %>
  <% quizQuestions.forEach(function(q) { %>
    addQuestion(<%- JSON.stringify(q) %>);
  <% }) %>
<% } %>

function addQuestion(data) {
  const q = data || {};
  const index = questionCount++;
  const container = document.getElementById('questionsContainer');
  const noMsg = document.getElementById('noQuestions');
  if (noMsg) noMsg.style.display = 'none';

  const rawOpts = q.options || (q.options === '' ? '[]' : '[]');
  const options = typeof rawOpts === 'string' ? JSON.parse(rawOpts) : rawOpts;
  const questionType = q.question_type || 'multiple_choice';

  let optionsHtml = '';
  if (questionType === 'multiple_choice') {
    optionsHtml = (options.length > 0 ? options : ['', '']).map(function(opt, oi) {
      return '<div class="flex items-center gap-2 mb-2">' +
        '<input type="radio" name="questions[' + index + '][correct_answer]" value="option_' + oi + '" ' + (q.correct_answer === 'option_' + oi ? 'checked' : '') + ' class="text-primary focus:ring-primary"/>' +
        '<input type="text" name="questions[' + index + '][options][]" value="' + (opt || '') + '" placeholder="خيار ' + (oi + 1) + '" class="flex-1 bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/>' +
        (oi > 1 ? '<button type="button" onclick="removeOption(this)" class="text-error hover:opacity-80"><span class="material-symbols-outlined text-[18px]">close</span></button>' : '') +
        '</div>';
    }).join('');
  }

  const div = document.createElement('div');
  div.className = 'question-card border border-outline-variant rounded-xl p-4 bg-surface-container-low relative';
  div.innerHTML = '<button type="button" onclick="removeQuestion(this)" class="absolute top-2 left-2 text-error hover:opacity-80"><span class="material-symbols-outlined text-lg">delete</span></button>' +
    '<div class="flex items-center gap-2 mb-3">' +
      '<span class="w-7 h-7 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-bold text-xs">' + (index + 1) + '</span>' +
      '<span class="font-headline-sm text-headline-sm text-on-surface text-sm">سؤال ' + (index + 1) + '</span>' +
    '</div>' +
    '<div class="space-y-3">' +
      '<div>' +
        '<textarea name="questions[' + index + '][question_text]" rows="1" class="w-full bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" placeholder="نص السؤال" required>' + (q.question_text || '') + '</textarea>' +
      '</div>' +
      '<div class="flex items-center gap-3">' +
        '<div class="flex-1">' +
          '<select name="questions[' + index + '][question_type]" onchange="changeQuestionType(this)" class="w-full bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">' +
            '<option value="multiple_choice" ' + (questionType === 'multiple_choice' ? 'selected' : '') + '>اختيار من متعدد</option>' +
            '<option value="true_false" ' + (questionType === 'true_false' ? 'selected' : '') + '>صح/خطأ</option>' +
          '</select>' +
        '</div>' +
        '<div class="w-20">' +
          '<input type="number" name="questions[' + index + '][points]" value="' + (q.points || 1) + '" min="1" class="w-full bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" placeholder="الدرجة"/>' +
        '</div>' +
      '</div>' +
      '<div class="options-container">' +
        '<label class="block font-label-lg text-label-lg text-on-surface mb-1 text-sm">الخيارات <span class="text-on-surface-variant font-body-md">(اختر الصحيح)</span></label>' +
        '<div class="options-list">' + optionsHtml + '</div>' +
        (questionType === 'multiple_choice' ? '<button type="button" onclick="addOption(this)" class="text-primary font-label-lg mt-1 flex items-center gap-1 hover:opacity-80 text-sm"><span class="material-symbols-outlined text-[14px]">add</span>إضافة خيار</button>' : '') +
      '</div>' +
    '</div>';

  container.appendChild(div);
}

function changeQuestionType(select) {
  const card = select.closest('.question-card');
  const optionsContainer = card.querySelector('.options-container');
  const match = card.querySelector('[name$="[question_text]"]')?.name?.match(/\[(\d+)\]/);
  const index = match ? match[1] : 0;

  if (select.value === 'true_false') {
    optionsContainer.innerHTML = '<label class="block font-label-lg text-label-lg text-on-surface mb-1 text-sm">الإجابة الصحيحة</label>' +
      '<div class="flex items-center gap-4">' +
        '<label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="questions[' + index + '][correct_answer]" value="true" class="text-primary focus:ring-primary"/> صح</label>' +
        '<label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="questions[' + index + '][correct_answer]" value="false" class="text-primary focus:ring-primary"/> خطأ</label>' +
      '</div>';
  } else {
    optionsContainer.innerHTML = '<label class="block font-label-lg text-label-lg text-on-surface mb-1 text-sm">الخيارات <span class="text-on-surface-variant font-body-md">(اختر الصحيح)</span></label>' +
      '<div class="options-list">' +
        '<div class="flex items-center gap-2 mb-2"><input type="radio" name="questions[' + index + '][correct_answer]" value="option_0" class="text-primary focus:ring-primary"/><input type="text" name="questions[' + index + '][options][]" placeholder="خيار 1" class="flex-1 bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/></div>' +
        '<div class="flex items-center gap-2 mb-2"><input type="radio" name="questions[' + index + '][correct_answer]" value="option_1" class="text-primary focus:ring-primary"/><input type="text" name="questions[' + index + '][options][]" placeholder="خيار 2" class="flex-1 bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/></div>' +
      '</div>' +
      '<button type="button" onclick="addOption(this)" class="text-primary font-label-lg mt-1 flex items-center gap-1 hover:opacity-80 text-sm"><span class="material-symbols-outlined text-[14px]">add</span>إضافة خيار</button>';
  }
}

function addOption(btn) {
  const list = btn.previousElementSibling;
  const match = list.querySelector('[name$="[options][]"]')?.name?.match(/\[(\d+)\]/);
  const index = match ? match[1] : 0;
  const optCount = list.children.length;
  const div = document.createElement('div');
  div.className = 'flex items-center gap-2 mb-2';
  div.innerHTML = '<input type="radio" name="questions[' + index + '][correct_answer]" value="option_' + optCount + '" class="text-primary focus:ring-primary"/>' +
    '<input type="text" name="questions[' + index + '][options][]" placeholder="خيار ' + (optCount + 1) + '" class="flex-1 bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/>' +
    '<button type="button" onclick="removeOption(this)" class="text-error hover:opacity-80"><span class="material-symbols-outlined text-[18px]">close</span></button>';
  list.appendChild(div);
}

function removeOption(btn) {
  const list = btn.closest('.options-list');
  if (list.children.length > 2) {
    btn.parentElement.remove();
  }
}

function removeQuestion(btn) {
  btn.closest('.question-card').remove();
  const remaining = document.querySelectorAll('.question-card');
  const noMsg = document.getElementById('noQuestions');
  if (remaining.length === 0 && noMsg) {
    noMsg.style.display = 'block';
  }
  remaining.forEach(function(card, i) {
    card.querySelector('.w-7').textContent = i + 1;
    card.querySelector('.font-headline-sm').textContent = 'سؤال ' + (i + 1);
  });
}
</script>
