<script>
function animateCounter(elementId, target, suffix) {
    var el = document.getElementById(elementId);
    if (!el) return;
    var current = 0;
    var increment = Math.ceil(target / 60);
    var timer = setInterval(function() {
        current += increment;
        if (current >= target) {
            current = target;
            clearInterval(timer);
        }
        el.textContent = current.toLocaleString('ar-SA') + (suffix || '');
    }, 25);
}

function isInViewport(el) {
    if (!el) return false;
    var rect = el.getBoundingClientRect();
    return rect.top < window.innerHeight - 100;
}

var countersStarted = false;
function checkCounters() {
    var section = document.querySelector('.bg-primary');
    if (!countersStarted && section && isInViewport(section)) {
        countersStarted = true;
        animateCounter('statStudents', <%= typeof stats !== 'undefined' && stats.students ? stats.students : 15000 %>);
        animateCounter('statLectures', <%= typeof stats !== 'undefined' && stats.lectures ? stats.lectures : 500 %>);
        animateCounter('statInstructors', <%= typeof stats !== 'undefined' && stats.instructors ? stats.instructors : 50 %>);
        animateCounter('statCertificates', <%= typeof stats !== 'undefined' && stats.certificates ? stats.certificates : 3000 %>);
    }
}

window.addEventListener('scroll', checkCounters);
window.addEventListener('load', checkCounters);
</script>