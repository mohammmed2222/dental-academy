<%- include('../partials/footer') %>

<script>
function toggleAccordion(element) {
    const item = element.parentElement;
    const isActive = item.classList.contains('active');
    document.querySelectorAll('.accordion-item').forEach(function(i) {
        i.classList.remove('active');
        i.classList.remove('ring-1', 'ring-primary');
    });
    if (!isActive) {
        item.classList.add('active');
        item.classList.add('ring-1', 'ring-primary');
    }
}

function scrollToCategory(id) {
    const target = document.getElementById(id);
    if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        const buttons = document.querySelectorAll('aside nav button');
        buttons.forEach(function(btn) {
            btn.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
            btn.classList.add('text-on-surface-variant', 'hover:bg-surface-container-high');
        });
        const currentBtn = Array.from(buttons).find(function(btn) { return btn.getAttribute('onclick').includes(id); });
        if (currentBtn) {
            currentBtn.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');
            currentBtn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-high');
        }
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const firstItem = document.querySelector('.accordion-item');
    if (firstItem) toggleAccordion(firstItem.querySelector('button'));

    const searchInput = document.getElementById('faqSearch');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            var term = this.value.toLowerCase().trim();
            document.querySelectorAll('.accordion-item').forEach(function(item) {
                var text = item.textContent.toLowerCase();
                item.style.display = text.includes(term) ? '' : 'none';
            });
            document.querySelectorAll('section[id]').forEach(function(section) {
                var hasVisible = Array.from(section.querySelectorAll('.accordion-item')).some(function(i) { return i.style.display !== 'none'; });
                var items = section.querySelectorAll('.accordion-item');
                section.style.display = (term === '' || hasVisible || items.length === 0) ? '' : 'none';
            });
        });
    }
});
</script>