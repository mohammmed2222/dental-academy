<%- include('../partials/header') %>
<%- include('../partials/back-button') %>

<main class="flex-grow max-w-container-max w-full mx-auto px-margin-mobile md:px-margin-desktop py-8 relative">
  <div class="absolute inset-0 sadu-pattern pointer-events-none -z-10"></div>

  <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center">
    <div>
      <h1 class="font-headline-lg text-headline-lg text-on-surface">المسارات التعليمية</h1>
      <p class="font-body-md text-body-md text-secondary mt-2">مسارات تعليمية متكاملة تجمع دورات متسلسلة لتحقيق هدف تعليمي محدد.</p>
    </div>
    <% if (typeof user !== 'undefined' && user && (user.role === 'instructor' || user.role === 'admin')) { %>
    <a href="/learning-paths/create" class="mt-4 md:mt-0 bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px]">add</span>
      إنشاء مسار تعليمي
    </a>
    <% } %>
  </div>

  <% if (paths.length > 0) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% paths.forEach(function(path) { %>
    <a href="/learning-paths/<%= path.id %>" class="block bg-surface-container-lowest border border-outline-variant rounded-xl p-6 flex flex-col hover:border-primary transition-colors duration-300 hard-shadow relative overflow-hidden group">
      <div class="absolute bottom-0 left-0 sadu-pattern w-24 h-24 opacity-10 rounded-tr-xl"></div>
      <div class="flex items-start justify-between mb-4">
        <div class="bg-primary-container/10 p-3 rounded-lg text-primary-container">
          <span class="material-symbols-outlined text-3xl">route</span>
        </div>
        <span class="bg-surface-container text-secondary font-label-lg text-label-lg px-2 py-1 rounded"><%= path.course_count %> دورة</span>
      </div>
      <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2 group-hover:text-primary transition-colors"><%= path.title %></h3>
      <p class="font-body-md text-body-md text-secondary mb-4 flex-grow line-clamp-2"><%= path.description %></p>
      <div class="border-t border-outline-variant pt-4 mt-auto">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined">person</span>
          </div>
          <div>
            <p class="font-label-lg text-label-lg text-on-surface"><%= path.instructor_name %></p>
            <p class="font-body-md text-body-md text-secondary text-sm"><%= path.student_count %> طالب مسجل</p>
          </div>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-12 text-center">
    <span class="material-symbols-outlined text-5xl text-on-surface-variant mb-4" style="font-variation-settings: 'FILL' 1;">route</span>
    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">لا توجد مسارات تعليمية بعد</h3>
    <p class="font-body-md text-body-md text-on-surface-variant">لم يتم إنشاء أي مسارات تعليمية حتى الآن.</p>
    <% if (typeof user !== 'undefined' && user && (user.role === 'instructor' || user.role === 'admin')) { %>
    <a href="/learning-paths/create" class="inline-block mt-4 bg-primary-container text-on-primary font-label-lg text-label-lg py-2 px-6 rounded hover:opacity-90 transition-opacity">إنشاء أول مسار</a>
    <% } %>
  </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
