<%- include('../partials/header', { minimalHeader: true }) %>
<%- include('../partials/back-button') %>

<main class="flex-grow flex items-center justify-center p-margin-mobile md:p-margin-desktop relative overflow-hidden">
  <div class="absolute inset-0 sadu-watermark pointer-events-none z-0"></div>
  <div class="absolute top-0 right-0 w-64 h-64 bg-primary-fixed opacity-20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 z-0"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-tertiary-fixed opacity-30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4 z-0"></div>

  <div class="w-full max-w-md bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm p-8 relative z-10 flex flex-col gap-6">
    <div class="text-center flex flex-col gap-2">
      <span class="material-symbols-outlined text-4xl text-primary mx-auto mb-2" style="font-variation-settings: 'FILL' 1;">dentistry</span>
      <h1 class="font-headline-lg text-headline-lg text-on-surface">تسجيل الدخول</h1>
      <p class="font-body-md text-body-md text-on-surface-variant">مرحباً بك مجدداً في أكاديمية طب الأسنان</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="flex items-center gap-2 bg-error-container text-on-error-container p-3 rounded font-body-md text-body-md">
      <span class="material-symbols-outlined text-sm">error</span>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="/auth/login" method="POST" class="flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="email">البريد الإلكتروني</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">person</span>
          <input class="w-full bg-surface border border-outline-variant rounded py-3 pl-3 pr-10 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" dir="rtl" id="email" name="email" placeholder="أدخل بريدك الإلكتروني" type="email" required/>
        </div>
      </div>
      <div class="flex flex-col gap-1">
        <div class="flex justify-between items-center">
          <label class="font-label-lg text-label-lg text-on-surface" for="password">كلمة المرور</label>
          <a class="font-label-sm text-label-sm text-primary hover:underline" href="/auth/forgot-password">نسيت كلمة المرور؟</a>
        </div>
        <div class="relative">
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">lock</span>
          <input class="w-full bg-surface border border-outline-variant rounded py-3 pl-3 pr-10 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" dir="rtl" id="password" name="password" placeholder="أدخل كلمة المرور" type="password" required/>
        </div>
      </div>
      <button class="w-full bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity flex items-center justify-center gap-2 mt-2" type="submit">
        <span>تسجيل الدخول</span>
        <span class="material-symbols-outlined text-sm">login</span>
      </button>
    </form>

    <div class="relative flex items-center py-2">
      <div class="flex-grow border-t border-outline-variant"></div>
      <span class="flex-shrink-0 mx-4 font-label-lg text-label-lg text-on-surface-variant">أو</span>
      <div class="flex-grow border-t border-outline-variant"></div>
    </div>

    <div class="text-center">
      <p class="font-body-md text-body-md text-on-surface-variant">
        ليس لديك حساب؟
        <a class="font-label-lg text-label-lg text-primary font-bold hover:text-on-primary-fixed-variant transition-colors hover:underline" href="/auth/register">إنشاء حساب جديد</a>
      </p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
