<%- include('../partials/header', { minimalHeader: true }) %>

<div class="fixed inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white via-[#fbf9f4] to-[#eae8e3] pointer-events-none"></div>

<main class="flex-grow flex items-center justify-center px-margin-mobile py-12 relative z-10">
<div class="w-full max-w-md">
<% if (typeof success !== 'undefined' && success) { %>
<div class="bg-error-container text-on-error-container rounded-lg p-4 mb-6 font-body-md text-center"><%= success %></div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="bg-error-container text-on-error-container rounded-lg p-4 mb-6 font-body-md text-center"><%= error %></div>
<% } %>
<div class="bg-surface-container-lowest border border-outline-variant p-8 md:p-10 shadow-sm relative overflow-hidden rounded-xl">
<div class="absolute top-0 right-0 w-32 h-32 opacity-5 pointer-events-none">
<span class="material-symbols-outlined text-[120px] text-primary">lock_reset</span>
</div>
<div class="relative">
<h1 class="font-headline-lg text-headline-lg text-primary mb-4 text-center">نسيت كلمة المرور</h1>
<p class="font-body-md text-on-surface-variant mb-8 leading-relaxed text-center">أدخل بريدك الإلكتروني المسجل وسنقوم بإرسال رابط مخصص لإعادة تعيين كلمة المرور الخاصة بك بشكل آمن.</p>
<form action="/auth/forgot-password" method="POST" class="space-y-6" id="resetForm">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="space-y-2">
<label class="block font-label-lg text-on-surface-variant" for="email">البريد الإلكتروني</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline">mail</span>
<input class="w-full bg-surface border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all font-body-md outline-none rounded-lg py-3 px-4 pr-12" id="email" name="email" placeholder="example@dental.jo" required="" type="email"/>
</div>
</div>
<button class="w-full bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-all flex items-center justify-center gap-2" type="submit">
<span>إرسال رابط الاستعادة</span>
<span class="material-symbols-outlined">arrow_back</span>
</button>
</form>
<div class="mt-8 pt-6 border-t border-outline-variant flex justify-center">
<a class="flex items-center gap-2 text-primary font-label-lg hover:underline transition-all" href="/auth/login">
<span class="material-symbols-outlined text-[18px]">chevron_right</span>
<span>العودة إلى صفحة تسجيل الدخول</span>
</a>
</div>
</div>
</div>
<div class="mt-8 flex justify-center gap-6 opacity-60">
<div class="flex flex-col items-center gap-1">
<span class="material-symbols-outlined">verified_user</span>
<span class="text-[10px] font-bold uppercase tracking-wider">Secure Access</span>
</div>
<div class="flex flex-col items-center gap-1">
<span class="material-symbols-outlined">encrypted</span>
<span class="text-[10px] font-bold uppercase tracking-wider">Encrypted Data</span>
</div>
</div>
</div>
</main>

<%- include('../partials/footer') %>

<div class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-inverse-surface text-inverse-on-surface px-6 py-4 rounded-lg shadow-xl translate-y-20 transition-transform duration-300 flex items-center gap-3 z-[100]" id="toast">
<span class="material-symbols-outlined text-primary-fixed">check_circle</span>
<span class="font-body-md">تم إرسال رابط الاستعادة إلى بريدك بنجاح</span>
</div>

<script>
document.getElementById('resetForm').addEventListener('submit', function(e) {
    var btn = e.target.querySelector('button');
    var originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span>';
    setTimeout(function() {
        var toast = document.getElementById('toast');
        toast.classList.remove('translate-y-20');
        setTimeout(function() {
            toast.classList.add('translate-y-20');
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }, 4000);
    }, 1200);
});
</script>
