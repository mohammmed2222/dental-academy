<%- include('../partials/header', { minimalHeader: true }) %>
<%- include('../partials/back-button') %>

<style>
  .sadu-pattern-bg {
    background-image: url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><path d="M0 20 L20 0 L40 20 L20 40 Z" fill="none" stroke="%23916f6c" stroke-width="0.5" stroke-opacity="0.15"/></svg>');
    background-repeat: repeat;
  }
</style>

<main class="flex-grow flex items-center justify-center py-12 px-margin-mobile md:px-margin-desktop relative overflow-hidden">
  <div class="absolute inset-0 sadu-pattern-bg pointer-events-none opacity-50"></div>
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-surface-container-low to-transparent pointer-events-none"></div>

  <div class="w-full max-w-2xl bg-surface-container-lowest rounded-xl border border-outline-variant p-8 md:p-12 relative z-10 shadow-sm">
    <div class="mb-8 text-center">
      <span class="material-symbols-outlined text-primary text-4xl mb-4" style="font-variation-settings: 'FILL' 1;">person_add</span>
      <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">إنشاء حساب جديد</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant">انضم إلى أكاديميتنا التعليمية الرائدة في طب الأسنان.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="flex items-center gap-2 bg-error-container text-on-error-container p-3 rounded font-body-md text-body-md mb-6">
      <span class="material-symbols-outlined text-sm">error</span>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="/auth/register" method="POST" class="space-y-6">
      <div>
        <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="name">الاسم الكامل</label>
        <div class="relative">
          <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md" id="name" name="name" placeholder="أدخل اسمك الكامل" required="" type="text"/>
          <span class="material-symbols-outlined absolute left-3 top-3 text-on-surface-variant">person</span>
        </div>
      </div>
      <div>
        <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="email">البريد الإلكتروني</label>
        <div class="relative">
          <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-left" dir="ltr" id="email" name="email" placeholder="name@example.com" required="" type="email"/>
          <span class="material-symbols-outlined absolute left-3 top-3 text-on-surface-variant">mail</span>
        </div>
      </div>
      <div>
        <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="role">نوع الحساب</label>
        <div class="relative">
          <select class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md appearance-none" id="role" name="role">
            <option value="student">طالب</option>
            <option value="instructor">مدرس</option>
          </select>
          <span class="material-symbols-outlined absolute left-3 top-3 text-on-surface-variant pointer-events-none">expand_more</span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="password">كلمة المرور</label>
          <div class="relative">
            <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-left" dir="ltr" id="password" name="password" placeholder="6 أحرف على الأقل" required="" type="password"/>
            <span class="material-symbols-outlined absolute left-3 top-3 text-on-surface-variant">lock</span>
          </div>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="confirmPassword">تأكيد كلمة المرور</label>
          <div class="relative">
            <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-left" dir="ltr" id="confirmPassword" name="confirmPassword" placeholder="أعد إدخال كلمة المرور" required="" type="password"/>
            <span class="material-symbols-outlined absolute left-3 top-3 text-on-surface-variant">lock</span>
          </div>
        </div>
      </div>
      <div class="flex items-start gap-3 mt-4">
        <div class="flex items-center h-5">
          <input class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary focus:ring-2 bg-surface cursor-pointer" id="terms" name="terms" required="" type="checkbox"/>
        </div>
        <label class="font-body-md text-body-md text-on-surface-variant cursor-pointer" for="terms">أوافق على <a class="text-primary hover:underline" href="#">الشروط والأحكام</a> وسياسة الخصوصية.</label>
      </div>
      <button class="w-full bg-primary-container text-on-primary py-3 px-6 rounded font-label-lg text-label-lg hover:opacity-90 transition-opacity flex items-center justify-center gap-2 mt-8" type="submit">
        <span>إنشاء حساب</span>
        <span class="material-symbols-outlined">arrow_back</span>
      </button>
      <div class="text-center mt-6">
        <p class="font-body-md text-body-md text-on-surface-variant">لديك حساب بالفعل؟ <a class="text-primary font-bold hover:underline" href="/auth/login">تسجيل الدخول</a></p>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
