<%- include('../partials/header') %>
<%- include('../partials/back-button') %>

<main class="flex-grow max-w-container-max w-full mx-auto px-margin-mobile md:px-margin-desktop py-8">
  <a href="/courses/<%= course.slug || course.id %>" class="inline-flex items-center gap-1 font-label-lg text-label-lg text-primary hover:underline mb-4">
    <span class="material-symbols-outlined text-sm">arrow_forward</span>
    العودة للدورة
  </a>

  <div class="flex items-center justify-between mb-6">
    <h1 class="font-headline-lg text-headline-lg text-on-surface">الإعلانات</h1>
    <% if (isOwner) { %>
    <button onclick="document.getElementById('createModal').classList.remove('hidden')" class="bg-primary-container text-on-primary-container font-label-lg text-label-lg px-4 py-2 rounded hover:opacity-90 transition-opacity flex items-center gap-1">
      <span class="material-symbols-outlined text-sm">add</span>
      إضافة إعلان
    </button>
    <% } %>
  </div>

  <% if (announcements.length === 0) { %>
  <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-12 text-center">
    <span class="material-symbols-outlined text-4xl text-on-surface-variant mb-3">campaign</span>
    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-1">لا توجد إعلانات بعد</h3>
    <p class="font-body-md text-body-md text-secondary">سيتم إضافة الإعلانات قريباً</p>
  </div>
  <% } else { %>
  <div class="space-y-4">
    <% announcements.forEach(function(a) { %>
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-6 hard-shadow">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <h2 class="font-headline-sm text-headline-sm text-on-surface mb-2"><%= a.title %></h2>
          <p class="font-body-md text-body-md text-secondary mb-4 whitespace-pre-wrap"><%= a.content %></p>
          <div class="flex items-center gap-4 text-sm text-secondary">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">person</span>
              <%= a.instructor_name %>
            </span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">schedule</span>
              <%= new Date(a.created_at).toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </span>
          </div>
        </div>
        <% if (isOwner) { %>
        <form action="/announcements/<%= a.id %>/delete" method="POST" onsubmit="return confirm('هل أنت متأكد من حذف هذا الإعلان؟')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="text-error hover:opacity-80 transition-opacity p-1">
            <span class="material-symbols-outlined">delete</span>
          </button>
        </form>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</main>

<% if (isOwner) { %>
<div id="createModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
  <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-6 w-full max-w-lg" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-headline-sm text-headline-sm text-on-surface">إعلان جديد</h2>
      <button onclick="document.getElementById('createModal').classList.add('hidden')" class="text-secondary hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <form action="/announcements/create/<%= course.id %>" method="POST" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block font-label-lg text-label-lg text-on-surface mb-1">العنوان</label>
        <input type="text" name="title" required class="w-full border border-outline-variant rounded px-3 py-2 font-body-md text-body-md focus:outline-none focus:border-primary">
      </div>
      <div>
        <label class="block font-label-lg text-label-lg text-on-surface mb-1">المحتوى</label>
        <textarea name="content" rows="4" required class="w-full border border-outline-variant rounded px-3 py-2 font-body-md text-body-md focus:outline-none focus:border-primary"></textarea>
      </div>
      <div class="flex gap-2 justify-end">
        <button type="button" onclick="document.getElementById('createModal').classList.add('hidden')" class="border border-outline-variant text-secondary font-label-lg text-label-lg px-4 py-2 rounded hover:bg-surface-container-low transition-colors">إلغاء</button>
        <button type="submit" class="bg-primary-container text-on-primary-container font-label-lg text-label-lg px-4 py-2 rounded hover:opacity-90 transition-opacity">نشر الإعلان</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
