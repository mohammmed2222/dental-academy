<%- include('../partials/header') %>
<%- include('../partials/back-button') %>

<main class="flex-1 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop py-8">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-surface-container-high flex items-center justify-center aspect-square rounded-full size-12 border border-surface-variant text-primary font-bold flex-shrink-0">
        <%= otherUser.name.charAt(0) %>
      </div>
      <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface"><%= otherUser.name %></h1>
        <p class="font-body-md text-body-md text-secondary">
          <%= otherUser.role === 'admin' ? 'مشرف' : otherUser.role === 'instructor' ? 'مدرس' : 'طالب' %>
        </p>
      </div>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 mb-6 space-y-4 max-h-[60vh] overflow-y-auto" id="messageContainer">
      <% if (messages.length > 0) { %>
        <% messages.forEach(function(m) { %>
          <% var isMine = m.sender_id === parseInt(user.id); %>
          <div class="flex <%= isMine ? 'justify-start' : 'justify-end' %>">
            <div class="max-w-[80%] <%= isMine ? 'bg-primary-container text-on-primary' : 'bg-surface-container-high text-on-surface' %> rounded-xl p-4">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-label-sm text-label-sm <%= isMine ? 'text-on-primary/80' : 'text-secondary' %>"><%= m.sender_name %></span>
                <span class="text-xs <%= isMine ? 'text-on-primary/60' : 'text-secondary' %>"><%= new Date(m.created_at).toLocaleString('ar-SA') %></span>
              </div>
              <p class="font-label-sm text-label-sm <%= isMine ? 'text-on-primary/90' : 'text-on-surface' %> font-medium"><%= m.subject %></p>
              <p class="font-body-md text-body-md <%= isMine ? 'text-on-primary/80' : 'text-secondary' %> mt-1 whitespace-pre-wrap"><%= m.content %></p>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12">
          <span class="material-symbols-outlined text-4xl text-secondary mb-3" style="font-variation-settings: 'FILL' 1;">chat</span>
          <p class="font-body-md text-body-md text-secondary">ابدأ المحادثة مع <%= otherUser.name %></p>
        </div>
      <% } %>
    </div>

    <form action="/messages/send" method="POST" class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4">
      <div class="space-y-4">
        <div>
          <input type="text" name="subject" placeholder="الموضوع" class="w-full bg-surface border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 font-body-md outline-none" required>
        </div>
        <div>
          <textarea name="content" placeholder="اكتب رسالتك..." rows="3" class="w-full bg-surface border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 font-body-md outline-none resize-none" required></textarea>
        </div>
        <div class="flex items-center justify-between">
          <div class="text-xs text-secondary">
            <span class="material-symbols-outlined text-[16px] align-middle">info</span>
            سيتم إرسال إشعار إلى <%= otherUser.name %>
          </div>
          <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-2 px-6 rounded hover:opacity-90 active:scale-[0.99] transition-all inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">send</span> إرسال
          </button>
        </div>
      </div>
      <input type="hidden" name="receiver_id" value="<%= otherUser.id %>">
    </form>
  </div>
</main>

<script>
  var container = document.getElementById('messageContainer');
  if (container) container.scrollTop = container.scrollHeight;
</script>

<%- include('../partials/footer') %>
