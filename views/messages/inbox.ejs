<%- include('../partials/header', { dashboardHeader: true }) %>
<%- include('../partials/back-button') %>

<main class="flex-1 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop py-8">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="font-headline-lg text-headline-lg text-on-surface">
        <%= typeof inboxMode !== 'undefined' && inboxMode ? 'الرسائل الواردة' : 'الرسائل' %>
      </h1>
      <div class="flex items-center gap-3">
        <a href="/messages/compose" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-2 px-4 rounded hover:opacity-90 transition-opacity inline-flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">add</span> رسالة جديدة
        </a>
      </div>
    </div>

    <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
    <div class="bg-primary-fixed/10 border border-primary/30 rounded-xl p-4 mb-6">
      <p class="font-body-md text-body-md text-on-surface flex items-center gap-2">
        <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">mail</span>
        لديك <strong><%= unreadCount %></strong> رسالة غير مقروءة
      </p>
    </div>
    <% } %>

    <% if (typeof conversations !== 'undefined') { %>
      <% if (conversations.length > 0) { %>
      <div class="space-y-2">
        <% conversations.forEach(function(c) { %>
        <a href="/messages/conversation/<%= c.other_user_id %>" class="block bg-surface-container-lowest border border-outline-variant rounded-xl p-4 hover:bg-surface-container-low transition-colors">
          <div class="flex items-start gap-3">
            <div class="bg-surface-container-high flex items-center justify-center aspect-square rounded-full size-12 border border-surface-variant text-primary font-bold flex-shrink-0">
              <%= c.other_user_name.charAt(0) %>
            </div>
            <div class="flex-grow min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-label-lg text-label-lg text-on-surface"><%= c.other_user_name %></h3>
                <span class="font-body-md text-body-md text-secondary text-sm"><%= new Date(c.last_message_at).toLocaleDateString('ar-SA') %></span>
              </div>
              <p class="font-body-md text-body-md text-secondary mt-1 truncate"><%= c.last_message || 'بدون رسائل' %></p>
            </div>
            <% if (c.unread_count > 0) { %>
            <span class="bg-primary-container text-on-primary text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 mt-1"><%= c.unread_count > 9 ? '9+' : c.unread_count %></span>
            <% } %>
          </div>
        </a>
        <% }) %>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <span class="material-symbols-outlined text-5xl text-secondary mb-4" style="font-variation-settings: 'FILL' 1;">mail</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">لا توجد محادثات</h3>
        <p class="font-body-md text-body-md text-secondary mb-6">لم تبدأ أي محادثة بعد</p>
        <a href="/messages/compose" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-2 px-6 rounded hover:opacity-90 transition-opacity">إرسال أول رسالة</a>
      </div>
      <% } %>
    <% } else if (typeof messages !== 'undefined') { %>
      <% if (messages.length > 0) { %>
      <div class="space-y-2">
        <% messages.forEach(function(m) { %>
        <a href="/messages/conversation/<%= m.sender_id %>" class="block bg-surface-container-lowest border border-outline-variant rounded-xl p-4 hover:bg-surface-container-low transition-colors <%= !m.is_read ? 'border-primary/30 bg-primary-fixed/10' : '' %>">
          <div class="flex items-start gap-3">
            <div class="bg-surface-container-high flex items-center justify-center aspect-square rounded-full size-12 border border-surface-variant text-primary font-bold flex-shrink-0">
              <%= m.sender_name.charAt(0) %>
            </div>
            <div class="flex-grow min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-label-lg text-label-lg text-on-surface"><%= m.sender_name %></h3>
                <span class="font-body-md text-body-md text-secondary text-sm"><%= new Date(m.created_at).toLocaleDateString('ar-SA') %></span>
              </div>
              <p class="font-label-sm text-label-sm text-on-surface font-medium mt-1"><%= m.subject %></p>
              <p class="font-body-md text-body-md text-secondary mt-0.5 truncate"><%= m.content %></p>
            </div>
            <% if (!m.is_read) { %>
            <span class="w-2.5 h-2.5 rounded-full bg-primary-container mt-2 flex-shrink-0"></span>
            <% } %>
          </div>
        </a>
        <% }) %>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <span class="material-symbols-outlined text-5xl text-secondary mb-4" style="font-variation-settings: 'FILL' 1;">inbox</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">لا توجد رسائل واردة</h3>
        <p class="font-body-md text-body-md text-secondary">عندما تستلم رسالة، ستظهر هنا</p>
      </div>
      <% } %>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
