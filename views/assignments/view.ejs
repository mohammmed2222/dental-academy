<%- include('../partials/header') %>
<%- include('../partials/back-button') %>



<main class="flex-grow max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8">
  <div class="max-w-3xl mx-auto">
    <a href="/lessons/<%= assignment.lesson_id %>" class="inline-flex items-center gap-1 text-primary font-label-lg text-label-lg hover:underline mb-6">
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
      العودة للدرس
    </a>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 shadow-sm mb-6">
      <h1 class="font-headline-lg text-headline-lg text-on-surface mb-3"><%= assignment.title %></h1>
      <p class="font-body-lg text-body-lg text-secondary mb-6"><%= assignment.description %></p>
      <div class="flex items-center gap-6 text-secondary font-body-md text-body-md">
        <% if (assignment.due_date) { %>
        <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">schedule</span> <%= new Date(assignment.due_date).toLocaleDateString('ar-SA') %></span>
        <% } %>
      </div>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 shadow-sm">
      <h2 class="font-headline-sm text-headline-sm text-on-surface mb-4">تسليم الواجب</h2>
      <form action="/assignments/<%= assignment.id %>/submit" method="POST" enctype="multipart/form-data" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">الملف (اختياري)</label>
          <input type="file" name="file" class="w-full bg-surface border border-outline-variant rounded py-2 px-3 font-body-md text-body-md focus:outline-none focus:border-primary"/>
        </div>
        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">التعليق</label>
          <textarea name="notes" rows="4" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary transition-colors" placeholder="أضف ملاحظاتك"></textarea>
        </div>
        <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-8 rounded hover:opacity-90 transition-opacity">تسليم الواجب</button>
      </form>
    </div>

    <% if (typeof submission !== 'undefined' && submission) { %>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 shadow-sm mt-6">
      <h2 class="font-headline-sm text-headline-sm text-on-surface mb-4">تسليمات سابقة</h2>
      <div class="flex items-center gap-3 text-secondary font-body-md text-body-md">
        <span class="material-symbols-outlined text-sm">check_circle</span>
        <span>تم التسليم في <%= new Date(submission.submitted_at).toLocaleDateString('ar-SA') %></span>
      </div>
      <% if (submission.graded_at) { %>
      <div class="mt-3 bg-primary-fixed-dim text-primary font-label-lg text-label-lg px-4 py-2 rounded inline-block">
        الدرجة: <%= submission.grade %>/<%= assignment.max_points || 100 %>
      </div>
      <% } else if (submission.submitted_at) { %>
      <div class="mt-3 bg-surface-container text-secondary font-label-lg text-label-lg px-4 py-2 rounded inline-block">
        بانتظار التصحيح
      </div>
      <% } %>
      <% if (submission.feedback) { %>
      <div class="mt-3 p-4 bg-surface-container-low rounded-lg font-body-md text-body-md text-on-surface">
        <strong>ملاحظات المدرس:</strong><br/>
        <%= submission.feedback %>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
