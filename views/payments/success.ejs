<%- include('../partials/header') %>
<main class="flex-grow flex items-center justify-center p-margin-mobile md:p-margin-desktop">
  <div class="max-w-md w-full bg-surface-container-lowest border border-outline-variant rounded-xl p-8 flex flex-col items-center gap-6 text-center">
    <div class="w-16 h-16 rounded-full bg-primary-fixed-dim flex items-center justify-center">
      <span class="material-symbols-outlined text-3xl text-primary" style="font-variation-settings:'FILL'1">check_circle</span>
    </div>
    <h1 class="font-headline-md text-headline-md text-on-surface">
      <%= payment.status === 'paid' ? 'تم الدفع بنجاح' : 'قيد المراجعة' %>
    </h1>
    <p class="font-body-md text-body-md text-on-surface-variant">
      <%= payment.status === 'paid' ? 'تم تفعيل تسجيلك في الكورس. يمكنك البدء بالتعلم الآن.' : 'سيتم مراجعة طلب الدفع الخاص بك وتأكيده قريباً.' %>
    </p>
    <div class="flex flex-col gap-2 w-full bg-surface rounded-lg p-4 font-body-md text-body-md">
      <div class="flex justify-between"><span class="text-on-surface-variant">رقم العملية</span><span class="text-on-surface" dir="ltr"><%= payment.id %></span></div>
      <div class="flex justify-between"><span class="text-on-surface-variant">المبلغ</span><span class="text-on-surface"><%= payment.amount %> ر.س</span></div>
      <div class="flex justify-between"><span class="text-on-surface-variant">طريقة الدفع</span><span class="text-on-surface"><%= {stripe:'بطاقة ائتمان', bank:'تحويل بنكي', cash:'نقدي'}[payment.method] %></span></div>
    </div>
    <div class="flex gap-3">
      <a href="/dashboard" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity">لوحة التحكم</a>
      <a href="/courses" class="bg-surface-container-high text-on-surface font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity">تصفح الكورسات</a>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
