<%- include('../partials/header') %>
<main class="flex-grow max-w-container-max mx-auto w-full p-margin-mobile md:p-margin-desktop flex flex-col gap-6">
  <div class="flex items-center gap-4">
    <a href="/courses/<%= course.slug %>" class="flex items-center gap-1 text-on-surface-variant hover:text-on-surface transition-colors font-label-lg text-label-lg">
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
      <span>العودة</span>
    </a>
  </div>

  <h1 class="font-headline-md text-headline-md text-on-surface">إتمام الدفع</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-surface-container-lowest border border-outline-variant rounded p-6 flex flex-col gap-6">
      <h2 class="font-label-lg text-label-lg text-on-surface">اختر طريقة الدفع</h2>

      <% if (error) { %>
      <div class="flex items-center gap-2 bg-error-container text-on-error-container p-3 rounded font-body-md text-body-md">
        <span class="material-symbols-outlined text-sm">error</span>
        <span><%= error %></span>
      </div>
      <% } %>

      <form action="/payments/request/<%= course.id %>" method="POST" enctype="multipart/form-data" class="flex flex-col gap-4">
        <label class="flex items-center gap-3 p-4 border border-outline-variant rounded cursor-pointer hover:bg-surface-container-low transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-fixed/10">
          <input type="radio" name="method" value="stripe" class="accent-primary" checked/>
          <div class="flex flex-col">
            <span class="font-label-lg text-label-lg text-on-surface">بطاقة ائتمان / مدى</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">دفع إلكتروني آمن عبر Stripe</span>
          </div>
        </label>

        <label class="flex items-center gap-3 p-4 border border-outline-variant rounded cursor-pointer hover:bg-surface-container-low transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-fixed/10">
          <input type="radio" name="method" value="bank" class="accent-primary"/>
          <div class="flex flex-col flex-1">
            <span class="font-label-lg text-label-lg text-on-surface">تحويل بنكي</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">حول المبلغ وأرفع صورة الإيصال</span>
            <div id="bankFields" class="hidden mt-3 flex flex-col gap-3">
              <div class="bg-surface p-3 rounded text-label-sm text-label-sm text-on-surface-variant">
                <p>مصرف الراجحي: SA00 0000 0000 0000 0000 0000</p>
                <p>المستفيد: أكاديمية طب الأسنان</p>
              </div>
              <div class="flex flex-col gap-1">
                <label class="font-label-sm text-label-sm text-on-surface" for="receipt">صورة الإيصال</label>
                <input class="w-full bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md text-body-md" id="receipt" name="receipt" type="file" accept="image/*"/>
              </div>
            </div>
          </div>
        </label>

        <label class="flex items-center gap-3 p-4 border border-outline-variant rounded cursor-pointer hover:bg-surface-container-low transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-fixed/10">
          <input type="radio" name="method" value="cash" class="accent-primary"/>
          <div class="flex flex-col">
            <span class="font-label-lg text-label-lg text-on-surface">دفع نقدي</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">سيتم التواصل معك لتأكيد الدفع</span>
          </div>
        </label>

        <div class="flex flex-col gap-1">
          <label class="font-label-lg text-label-lg text-on-surface" for="coupon_code">كود خصم (اختياري)</label>
          <input class="w-full max-w-xs bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md text-left" dir="ltr" id="coupon_code" name="coupon_code" placeholder="أدخل الكود"/>
        </div>

        <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity flex items-center justify-center gap-2 self-start">
          <span class="material-symbols-outlined text-sm">lock</span>
          <span>إتمام الدفع</span>
        </button>
      </form>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded p-6 flex flex-col gap-4 h-fit">
      <h2 class="font-label-lg text-label-lg text-on-surface">ملخص الطلب</h2>
      <div class="flex items-center gap-3">
        <img src="<%= course.image || '/images/default-course.png' %>" class="w-16 h-12 rounded object-cover" alt=""/>
        <div>
          <p class="font-body-md text-body-md text-on-surface"><%= course.title %></p>
          <p class="font-label-sm text-label-sm text-on-surface-variant"><%= course.level === 'beginner' ? 'مبتدئ' : course.level === 'intermediate' ? 'متوسط' : 'متقدم' %></p>
        </div>
      </div>
      <div class="border-t border-outline-variant pt-4 flex flex-col gap-2">
        <div class="flex justify-between font-body-md text-body-md">
          <span class="text-on-surface-variant">السعر</span>
          <span class="text-on-surface"><%= course.price %> ر.س</span>
        </div>
        <div class="flex justify-between font-label-lg text-label-lg">
          <span class="text-on-surface">الإجمالي</span>
          <span class="text-primary"><%= course.price %> ر.س</span>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
document.querySelectorAll('input[name="method"]').forEach(function(r) {
  r.addEventListener('change', function() {
    document.getElementById('bankFields').classList.toggle('hidden', this.value !== 'bank');
  });
});
</script>
<%- include('../partials/footer') %>
