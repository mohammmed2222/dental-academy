<%- include('../partials/header', { dashboardHeader: true }) %>
<%- include('../partials/back-button') %>

<main class="flex-1 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop py-8">
  <div>
    <h1 class="font-headline-lg text-headline-lg text-on-surface">إدارة المدفوعات</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant">مراجعة طلبات الدفع</p>
  </div>

  <div class="mt-8 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-right">
        <thead class="bg-surface-container border-b border-outline-variant">
          <tr>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">الطالب</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">المساق</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">المبلغ</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">الخصم</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">طريقة الدفع</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">الحالة</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">التاريخ</th>
            <th class="px-4 py-3 font-label-lg text-label-lg text-on-surface">الإجراءات</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant">
          <% payments.forEach(function(p) { %>
          <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label-lg text-label-lg text-on-surface"><%= p.user_name %></td>
            <td class="px-4 py-3 text-on-surface-variant font-body-md text-body-md"><%= p.course_title %></td>
            <td class="px-4 py-3 text-on-surface-variant font-body-md text-body-md"><%= p.amount %> ر.س</td>
            <td class="px-4 py-3 text-on-surface-variant font-body-md text-body-md">
              <% if (p.discount_amount > 0) { %><span class="text-error font-label-lg"><%= p.discount_amount %> ر.س</span><% } else { %>—<% } %>
            </td>
            <td class="px-4 py-3 text-on-surface-variant font-body-md text-body-md">
              <% if (p.method === 'stripe') { %>بطاقة ائتمان<% } else if (p.method === 'bank') { %>
                تحويل بنكي
                <% if (p.receipt_image) { %>
                <a href="<%= p.receipt_image %>" target="_blank" class="text-primary hover:underline block text-xs">عرض الإيصال</a>
                <% } %>
              <% } else { %>نقدي<% } %>
            </td>
            <td class="px-4 py-3">
              <span class="font-label-lg text-label-lg px-3 py-1 rounded <%= p.status === 'paid' ? 'bg-primary-fixed-dim text-primary' : p.status === 'rejected' ? 'bg-error-container text-on-error-container' : 'bg-secondary-container text-on-secondary-container' %>">
                <%= p.status === 'paid' ? 'مدفوع' : p.status === 'rejected' ? 'مرفوض' : 'قيد المراجعة' %>
              </span>
            </td>
            <td class="px-4 py-3 text-on-surface-variant font-body-md text-body-md"><%= new Date(p.created_at).toLocaleDateString('ar-SA') %></td>
            <td class="px-4 py-3">
              <% if (p.status === 'pending') { %>
              <div class="flex items-center gap-2">
                <form action="/payments/admin/<%= p.id %>/confirm" method="POST" style="display:inline">
                  <button type="submit" class="bg-primary-fixed-dim text-primary font-label-lg text-label-lg px-3 py-1 rounded hover:opacity-80 transition-opacity">تأكيد</button>
                </form>
                <form action="/payments/admin/<%= p.id %>/reject" method="POST" style="display:inline" onsubmit="var r=prompt('سبب الرفض:');if(!r)return false;this.querySelector('input[name=reason]').value=r">
                  <input type="hidden" name="reason"/>
                  <button type="submit" class="bg-error-container text-on-error-container font-label-lg text-label-lg px-3 py-1 rounded hover:opacity-80 transition-opacity">رفض</button>
                </form>
              </div>
              <% } else { %>
              <span class="text-on-surface-variant font-body-md text-body-md">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (payments.length === 0) { %>
          <tr><td colspan="8" class="px-4 py-8 text-center text-on-surface-variant font-body-md text-body-md">لا توجد مدفوعات بعد</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (totalPages > 1) { %>
  <div class="flex items-center justify-center gap-2 mt-6">
    <% for (var i = 1; i <= totalPages; i++) { %>
    <a href="/payments/admin?page=<%= i %>" class="px-3 py-1 rounded font-label-lg text-label-lg <%= page === i ? 'bg-primary-container text-on-primary' : 'bg-surface-container text-on-surface hover:bg-surface-container-high' %>"><%= i %></a>
    <% } %>
  </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
