<%- include('../partials/header') %>
<%- include('../partials/back-button') %>

<main class="flex-1 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop py-8">
  <div class="max-w-3xl mx-auto">
    <div class="mb-8">
      <h1 class="font-headline-lg text-headline-lg text-on-surface"><%= question ? 'تعديل السؤال' : 'إضافة سؤال' %></h1>
      <p class="font-body-lg text-body-lg text-secondary"><%= question ? 'تعديل السؤال في بنك الأسئلة' : 'أضف سؤالاً جديداً إلى بنك الأسئلة' %></p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-error-container text-on-error-container border border-error rounded-xl p-4 mb-6 font-body-md text-body-md">
      <span class="material-symbols-outlined text-[18px] align-middle ml-1">error</span>
      <%= error %>
    </div>
    <% } %>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 shadow-sm">
      <form action="<%= question ? '/question-bank/' + question.id + '/edit' : '/question-bank/create' %>" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>

        <div>
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="question_text">نص السؤال</label>
          <textarea id="question_text" name="question_text" rows="3" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" placeholder="أدخل نص السؤال" required><%= question ? question.question_text : '' %></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div>
            <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="question_type">نوع السؤال</label>
            <select id="question_type" name="question_type" onchange="toggleQuestionType()" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
              <option value="multiple_choice" <%= question && question.question_type === 'multiple_choice' ? 'selected' : '' %>>اختيار من متعدد</option>
              <option value="multiple_correct" <%= question && question.question_type === 'multiple_correct' ? 'selected' : '' %>>اختيار متعدد الإجابات</option>
              <option value="true_false" <%= question && question.question_type === 'true_false' ? 'selected' : '' %>>صح/خطأ</option>
              <option value="essay" <%= question && question.question_type === 'essay' ? 'selected' : '' %>>مقالي</option>
            </select>
          </div>
          <div>
            <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="points">الدرجة</label>
            <input type="number" id="points" name="points" value="<%= question ? question.points : 1 %>" min="1" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/>
          </div>
          <div>
            <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="category">التصنيف</label>
            <input type="text" id="category" name="category" value="<%= question ? question.category : '' %>" placeholder="مثلاً: تشريح, فيزيولوجيا..." class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/>
          </div>
        </div>

        <div id="optionsSection" class="border-t border-outline-variant pt-5">
          <div class="flex items-center justify-between mb-3">
            <label class="block font-label-lg text-label-lg text-on-surface">الخيارات</label>
            <button type="button" onclick="addOption()" class="text-primary font-label-lg flex items-center gap-1 hover:opacity-80">
              <span class="material-symbols-outlined text-[18px]">add</span>
              إضافة خيار
            </button>
          </div>
          <div id="optionsContainer" class="space-y-2"></div>
          <p id="noOptionsMsg" class="font-body-md text-body-md text-on-surface-variant text-center py-4">لم يتم إضافة خيارات. اضغط على "إضافة خيار" للبدء.</p>
        </div>

        <div id="trueFalseSection" class="border-t border-outline-variant pt-5 hidden">
          <label class="block font-label-lg text-label-lg text-on-surface mb-2">الإجابة الصحيحة</label>
          <div class="flex items-center gap-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="correct_answer" value="true" <%= question && question.correct_answer === 'true' ? 'checked' : '' %> class="text-primary focus:ring-primary"/> صح
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="correct_answer" value="false" <%= question && question.correct_answer === 'false' ? 'checked' : '' %> class="text-primary focus:ring-primary"/> خطأ
            </label>
          </div>
        </div>

        <div id="essaySection" class="border-t border-outline-variant pt-5 hidden">
          <label class="block font-label-lg text-label-lg text-on-surface mb-2" for="correct_answer_essay">الإجابة الصحيحة</label>
          <textarea id="correct_answer_essay" name="correct_answer" rows="3" class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" placeholder="أدخل الإجابة النموذجية"><%= question && (question.question_type === 'essay') ? question.correct_answer : '' %></textarea>
        </div>

        <div class="flex items-center gap-4 pt-4">
          <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-8 rounded hover:opacity-90 transition-opacity">
            <%= question ? 'حفظ التغييرات' : 'إضافة السؤال' %>
          </button>
          <a href="/question-bank" class="border border-outline-variant text-secondary font-label-lg text-label-lg py-3 px-8 rounded hover:bg-surface-container-low transition-colors">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
var question = <%- JSON.stringify(question).replace(/<\//g, '<\\/') %>;
var options = (question && question.options) ? (typeof question.options === 'string' ? JSON.parse(question.options) : question.options) : [];
var questionType = question ? question.question_type : 'multiple_choice';
var optionCount = 0;

function toggleQuestionType() {
  var type = document.getElementById('question_type').value;
  document.getElementById('optionsSection').classList.toggle('hidden', type !== 'multiple_choice' && type !== 'multiple_correct');
  document.getElementById('trueFalseSection').classList.toggle('hidden', type !== 'true_false');
  document.getElementById('essaySection').classList.toggle('hidden', type !== 'essay');
}

function addOption(value) {
  var container = document.getElementById('optionsContainer');
  var noMsg = document.getElementById('noOptionsMsg');
  if (noMsg) noMsg.style.display = 'none';

  var index = optionCount++;
  var type = document.getElementById('question_type').value;
  var inputType = type === 'multiple_correct' ? 'checkbox' : 'radio';
  var name = type === 'multiple_correct' ? 'correct_answer' : 'correct_answer';

  var div = document.createElement('div');
  div.className = 'flex items-center gap-2';
  div.id = 'optionRow_' + index;
  div.innerHTML =
    '<input type="' + inputType + '" name="' + name + '" value="option_' + index + '" ' +
    (question && type !== 'multiple_correct' && question.correct_answer === 'option_' + index ? 'checked' : '') + ' ' +
    (question && type === 'multiple_correct' && question.correct_answer && question.correct_answer.split(',').indexOf('option_' + index) !== -1 ? 'checked' : '') + ' ' +
    'class="text-primary focus:ring-primary"/>' +
    '<input type="text" name="options[]" value="' + (value || '') + '" placeholder="خيار ' + (optionCount) + '" class="flex-1 bg-surface border border-outline-variant rounded py-2 px-3 text-on-surface font-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/>' +
    (optionCount > 2 ? '<button type="button" onclick="removeOption(' + index + ')" class="text-error hover:opacity-80"><span class="material-symbols-outlined text-[18px]">close</span></button>' : '');
  container.appendChild(div);
}

function removeOption(index) {
  var el = document.getElementById('optionRow_' + index);
  if (el) {
    el.remove();
    var remaining = document.querySelectorAll('#optionsContainer > div');
    if (remaining.length === 0) {
      document.getElementById('noOptionsMsg').style.display = 'block';
    }
  }
}

toggleQuestionType();

if (options.length > 0) {
  options.forEach(function(opt) {
    addOption(opt);
  });
} else {
  addOption('');
  addOption('');
}
</script>
