  <style>
    body {
      background-color: #fbf9f4;
      color: #1b1c19;
      font-family: 'IBM Plex Sans Arabic', sans-serif;
    }
    .sadu-pattern {
      background-image: radial-gradient(#ce1126 0.5px, transparent 0.5px);
      background-size: 24px 24px;
      opacity: 0.05;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .dark body {
      background: #1a1c1e !important;
      color: #e3e3e3;
    }
    .dark .bg-background { background: #1a1c1e !important; }
    .dark .bg-surface { background: #1a1c1e !important; }
    .dark .bg-surface-container-lowest { background: #2a2c2e !important; }
    .dark .bg-surface-container { background: #333537 !important; }
    .dark .bg-surface-container-low { background: #2a2c2e !important; }
    .dark .bg-surface-container-high { background: #3a3c3e !important; }
    .dark .bg-surface-container-highest { background: #404244 !important; }
    .dark .bg-surface-variant { background: #444749 !important; }
    .dark .bg-surface-dim { background: #1a1c1e !important; }
    .dark .bg-surface-bright { background: #3a3c3e !important; }
    .dark .border-outline-variant { border-color: #444749 !important; }
    .dark .text-on-surface { color: #e3e3e3 !important; }
    .dark .text-secondary { color: #c4c6c6 !important; }
    .dark .text-on-surface-variant { color: #c4c6c6 !important; }
    .dark .text-on-secondary-fixed { color: #e3e3e3 !important; }
    .dark .text-on-tertiary-fixed { color: #e3e3e3 !important; }
