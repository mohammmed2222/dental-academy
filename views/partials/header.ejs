  <% } %>
  <nav class="flex flex-col py-2">
    <a href="/" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">home</span> الرئيسية
    </a>
    <a href="/courses" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">school</span> الدورات
    </a>
    <a href="/learning-paths" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">route</span> المسارات التعليمية
    </a>
    <hr class="mx-4 border-outline-variant my-1">
    <% if (typeof user === 'undefined' || !user) { %>
    <a href="/about" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">info</span> عن المنصة
    </a>
    <a href="/faq" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">help</span> الأسئلة الشائعة
    </a>
    <a href="/contact" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">mail</span> تواصل معنا
