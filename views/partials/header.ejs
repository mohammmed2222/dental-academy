<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>أكاديمية طب الأسنان</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#e2e2e5",
            "on-surface-variant": "#5c3f3d",
            "on-primary-container": "#ffe0dd",
            "inverse-on-surface": "#f2f1ec",
            "surface-container-highest": "#e4e2dd",
            "primary-fixed-dim": "#ffb3ae",
            "tertiary-fixed": "#e0e2e8",
            "surface-container-lowest": "#ffffff",
            "on-secondary-fixed-variant": "#454749",
            "inverse-primary": "#ffb3ae",
            "secondary-fixed-dim": "#c6c6c9",
            "on-primary-fixed-variant": "#930015",
            "surface-variant": "#e4e2dd",
            "surface-dim": "#dbdad5",
            error: "#ba1a1a",
            "surface-container": "#f0eee9",
            "surface-container-low": "#f5f3ee",
            "on-tertiary": "#ffffff",
            background: "#fbf9f4",
            "on-error": "#ffffff",
            "on-tertiary-fixed-variant": "#44474c",
            "tertiary-fixed-dim": "#c4c6cc",
            "tertiary-container": "#65686d",
            "surface-bright": "#fbf9f4",
            "on-tertiary-container": "#e6e7ee",
            "on-error-container": "#93000a",
            "on-primary": "#ffffff",
            surface: "#fbf9f4",
            tertiary: "#4d5055",
            "on-secondary-container": "#636467",
            "outline-variant": "#e6bdba",
            "surface-container-high": "#eae8e3",
            "on-secondary-fixed": "#1a1c1e",
            primary: "#a30019",
            "on-secondary": "#ffffff",
            "primary-container": "#ce1126",
            secondary: "#5d5e61",
            "inverse-surface": "#30312e",
            "surface-tint": "#c0001f",
            "on-surface": "#1b1c19",
            "error-container": "#ffdad6",
            outline: "#916f6c",
            "on-primary-fixed": "#410004",
            "primary-fixed": "#ffdad7",
            "on-background": "#1b1c19",
            "secondary-fixed": "#e2e2e5",
            "on-tertiary-fixed": "#191c20"
          },
          borderRadius: {
            DEFAULT: "0.125rem",
            lg: "0.25rem",
            xl: "0.5rem",
            full: "0.75rem"
          },
          spacing: {
            unit: "8px",
            "margin-desktop": "40px",
            "margin-mobile": "16px",
            gutter: "24px",
            "container-max": "1280px",
            "stack-lg": "48px",
            "stack-md": "24px"
          },
          fontFamily: {
            "label-lg": ["IBM Plex Sans Arabic"],
            "label-sm": ["IBM Plex Sans Arabic"],
            "headline-sm": ["IBM Plex Sans Arabic"],
            "headline-xl": ["IBM Plex Sans Arabic"],
            "headline-md": ["IBM Plex Sans Arabic"],
            "display-lg": ["IBM Plex Sans Arabic"],
            "body-md": ["IBM Plex Sans Arabic"],
            "headline-lg-mobile": ["IBM Plex Sans Arabic"],
            "headline-lg": ["IBM Plex Sans Arabic"],
            "body-lg": ["IBM Plex Sans Arabic"]
          },
          fontSize: {
            "label-lg": ["14px", { lineHeight: "20px", fontWeight: "500" }],
            "label-sm": ["12px", { lineHeight: "16px", fontWeight: "500" }],
            "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "600" }],
            "headline-xl": ["40px", { lineHeight: "48px", fontWeight: "700" }],
            "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
            "display-lg": ["48px", { lineHeight: "60px", letterSpacing: "0", fontWeight: "700" }],
            "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "headline-lg-mobile": ["28px", { lineHeight: "36px", fontWeight: "600" }],
            "headline-lg": ["32px", { lineHeight: "40px", fontWeight: "600" }],
            "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }]
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #fbf9f4;
      color: #1b1c19;
      font-family: 'IBM Plex Sans Arabic', sans-serif;
    }
    .sadu-pattern {
      background-image: radial-gradient(#ce1126 0.5px, transparent 0.5px);
      background-size: 24px 24px;
      opacity: 0.05;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

<% if (typeof headOnly !== 'undefined' && headOnly) { %>
<% } else if (typeof minimalHeader !== 'undefined' && minimalHeader) { %>
<header class="bg-background/95 backdrop-blur-md text-secondary border-b border-secondary/30 w-full sticky top-0 z-50 h-16 flex items-center justify-center">
  <div class="px-gutter w-full max-w-container-max mx-auto text-center">
    <span class="font-headline-md text-headline-md font-bold text-secondary">أكاديمية طب الأسنان</span>
  </div>
</header>
<% } else if (typeof dashboardHeader !== 'undefined' && dashboardHeader) { %>
<div class="relative flex h-auto w-full flex-col bg-surface group/design-root overflow-x-hidden border-b border-surface-variant">
  <div class="flex h-full grow flex-col">
    <div class="px-margin-mobile md:px-margin-desktop flex flex-1 justify-center py-5">
      <div class="layout-content-container flex flex-col max-w-container-max flex-1">
        <header class="flex items-center justify-between whitespace-nowrap px-0 md:px-10 py-3">
          <div class="flex items-center gap-8">
            <div class="flex items-center gap-4 text-on-surface">
              <div class="size-6 text-primary">
                <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z" fill="currentColor"></path>
                </svg>
              </div>
              <h2 class="text-on-surface text-headline-sm tracking-[-0.015em]">أكاديمية طب الأسنان</h2>
            </div>
          </div>
          <div class="flex flex-1 justify-end gap-8">
            <div class="flex items-center gap-9">
              <a href="/notifications" class="text-secondary hover:text-primary transition-colors flex items-center justify-center relative">
                <span class="material-symbols-outlined text-[24px]">notifications</span>
                <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
                <span class="absolute -top-1 -right-1 bg-primary-container text-on-primary text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center" style="font-size:10px;"><%= unreadNotifications > 9 ? '9+' : unreadNotifications %></span>
                <% } %>
              </a>
              <% if (typeof user !== 'undefined' && user) { %>
              <a href="/auth/logout" class="font-label-lg text-label-lg text-secondary hover:text-primary transition-colors">تسجيل الخروج</a>
              <% } %>
            </div>
            <div class="flex items-center gap-3">
              <div class="text-right hidden md:block">
                <p class="text-label-lg text-on-surface m-0"><%= typeof user !== 'undefined' && user ? user.name : 'زائر' %></p>
                <p class="text-sm text-secondary m-0"><%= typeof user !== 'undefined' && user ? (user.role === 'admin' ? 'مشرف' : user.role === 'instructor' ? 'مدرس' : 'طالب') : '' %></p>
              </div>
              <div class="bg-surface-container-high flex items-center justify-center aspect-square rounded-full size-10 border border-surface-variant text-primary font-bold">
                <%= typeof user !== 'undefined' && user ? user.name.charAt(0) : 'ز' %>
              </div>
            </div>
          </div>
        </header>
      </div>
    </div>
  </div>
</div>
<% } else { %>
<header class="bg-background/95 backdrop-blur-md text-secondary shadow-sm shadow-secondary/5 border-b border-secondary/30 sticky top-0 z-50 h-20">
  <div class="flex flex-row-reverse justify-between items-center w-full px-gutter max-w-container-max mx-auto h-full">
    <a href="/" class="font-headline-xl text-headline-xl text-secondary drop-shadow-sm font-bold">أكاديمية طب الأسنان</a>
    <nav class="hidden md:flex flex-row-reverse gap-8 items-center">
      <a href="/" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الرئيسية</a>
      <a href="/courses" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/courses') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الدورات</a>
      <% if (typeof user === 'undefined' || !user) { %>
      <a href="/about" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/about' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">عن المنصة</a>
      <a href="/faq" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/faq' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الأسئلة الشائعة</a>
      <a href="/contact" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/contact' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">تواصل معنا</a>
      <% } %>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/dashboard') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">لوحة التحكم</a>
        <a href="/notifications" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/notifications') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الإشعارات<% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %> (<%= unreadNotifications %>)<% } %></a>
        <% if (user.role === 'admin') { %>
        <a href="/admin" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الإدارة</a>
        <% } %>
      <% } %>
    </nav>
    <div class="flex items-center gap-3">
      <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="hidden md:flex items-center gap-2 font-label-lg text-label-lg text-on-surface hover:text-secondary transition-colors">
        <span class="w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-bold text-sm"><%= user.name.charAt(0) %></span>
        <span><%= user.name %></span>
      </a>
      <a href="/dashboard/profile" class="hidden md:inline font-label-lg text-label-lg text-on-surface/70 hover:text-secondary transition-colors">الملف الشخصي</a>
      <a href="/auth/logout" class="bg-primary-container text-on-primary px-5 py-2 rounded-lg font-label-lg text-label-lg scale-95 active:scale-90 hover:bg-primary-container/90 transition-all">تسجيل الخروج</a>
      <% } else { %>
      <a href="/auth/login" class="bg-primary-container text-on-primary px-6 py-2 rounded-lg font-label-lg text-label-lg transition-transform scale-95 active:scale-90 hover:bg-primary-container/90">تسجيل الدخول</a>
      <% } %>
    </div>
  </div>
</header>
<% } %>
