    <% } %>
    <% if (typeof user !== 'undefined' && user) { %>
    <hr class="mx-4 border-outline-variant my-1">
    <a href="/dashboard" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">dashboard</span> لوحة التحكم
    </a>
    <a href="/notifications" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
