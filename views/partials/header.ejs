        <% } %>
        <% if (user.role === 'admin') { %>
        <a href="/admin" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الإدارة</a>
        <% } %>
      <% } %>
    </nav>

    <!-- Right side: actions -->
    <div class="flex items-center gap-2 md:gap-3">
