      <a href="/learning-paths" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/learning-paths') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">المسارات</a>
      <% if (typeof user === 'undefined' || !user) { %>
      <a href="/about" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/about' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">عن المنصة</a>
      <a href="/faq" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/faq' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الأسئلة</a>
      <a href="/contact" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/contact' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">تواصل معنا</a>
      <% } %>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/dashboard') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">لوحة التحكم</a>
        <a href="/messages" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/messages') ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الرسائل</a>
        <% if (user.role === 'admin' || user.role === 'instructor') { %>
