            tertiary: "#4d5055",
            "on-secondary-container": "#636467",
            "outline-variant": "#e6bdba",
            "surface-container-high": "#eae8e3",
            "on-secondary-fixed": "#1a1c1e",
            primary: "#a30019",
            "on-secondary": "#ffffff",
            "primary-container": "#ce1126",
            secondary: "#5d5e61",
            "inverse-surface": "#30312e",
            "surface-tint": "#c0001f",
            "on-surface": "#1b1c19",
            "error-container": "#ffdad6",
