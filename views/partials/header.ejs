    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-bold text-lg"><%= user.name.charAt(0) %></div>
      <div>
        <p class="font-label-lg text-label-lg text-on-surface"><%= user.name %></p>
        <p class="text-sm text-secondary"><%= user.role === 'admin' ? 'مشرف' : user.role === 'instructor' ? 'مدرس' : 'طالب' %></p>
      </div>
