    <% } %>
    <hr class="mx-4 border-outline-variant my-1">
    <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3.5 text-error hover:bg-error-container/20 transition-colors font-body-md" onclick="closeMobileMenu()">
