      <% } %>

      <!-- Mobile Menu Button -->
      <button onclick="toggleMobileMenu()" class="block md:hidden text-secondary hover:text-primary transition-colors w-10 h-10 rounded-full hover:bg-secondary/10 flex items-center justify-center" aria-label="القائمة">
