        <span class="w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-bold text-sm"><%= user.name.charAt(0) %></span>
        <span class="hidden lg:inline"><%= user.name %></span>
      </a>
      <a href="/auth/logout" class="hidden md:inline-block bg-primary-container text-on-primary px-4 lg:px-5 py-2 rounded-lg font-label-lg text-label-lg text-sm lg:text-base scale-95 active:scale-90 hover:bg-primary-container/90 transition-all">تسجيل الخروج</a>
      <% } else { %>
