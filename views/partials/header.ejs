</head>
<body class="min-h-screen flex flex-col">

<% if (typeof minimalHeader !== 'undefined' && minimalHeader) { %>
<header class="bg-background/95 backdrop-blur-md text-secondary border-b border-secondary/30 w-full sticky top-0 z-50 h-16 flex items-center justify-center">
  <div class="px-gutter w-full max-w-container-max mx-auto text-center">
    <span class="font-headline-md text-headline-md font-bold text-secondary">أكاديمية طب الأسنان</span>
  </div>
</header>
<% } else { %>
