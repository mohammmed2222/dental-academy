    <a href="/messages" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">chat</span> الرسائل
    </a>
    <a href="/dashboard/profile" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">person</span> الملف الشخصي
    </a>
    <a href="/dashboard/grades" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">grade</span> درجاتي
    </a>
    <a href="/dashboard/analytics" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">analytics</span> تحليلات الأداء
    </a>
    <% if (user.role === 'admin' || user.role === 'instructor') { %>
    <hr class="mx-4 border-outline-variant my-1">
    <a href="/question-bank" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">quiz</span> بنك الأسئلة
    </a>
    <% } %>
    <% if (user.role === 'admin') { %>
    <a href="/admin" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">admin_panel_settings</span> لوحة الإدارة
    </a>
    <a href="/payments/admin" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">payments</span> المدفوعات
    </a>
    <a href="/coupons/admin" class="flex items-center gap-3 px-4 py-3.5 text-on-surface hover:bg-secondary/10 transition-colors font-body-md" onclick="closeMobileMenu()">
      <span class="material-symbols-outlined text-secondary text-[20px]">card_giftcard</span> كوبونات الخصم
