      <span class="material-symbols-outlined text-primary text-2xl md:text-3xl" style="font-variation-settings: 'FILL' 1;">dentistry</span>
      <span class="hidden xs:inline">أكاديمية طب الأسنان</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex flex-row-reverse gap-6 lg:gap-8 items-center">
      <a href="/" class="font-body-md text-body-md <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'text-secondary font-bold border-b-2 border-secondary pb-1' : 'text-on-surface/80 hover:text-secondary transition-colors duration-300' %>">الرئيسية</a>
