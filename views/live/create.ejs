<%- include('../partials/header') %>
<main class="flex-grow max-w-container-max mx-auto w-full p-margin-mobile md:p-margin-desktop flex flex-col gap-6">
  <div class="flex items-center gap-4">
    <a href="/live/course/<%= course.id %>" class="flex items-center gap-1 text-on-surface-variant hover:text-on-surface transition-colors font-label-lg text-label-lg">
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
      <span>العودة</span>
    </a>
  </div>
  <h1 class="font-headline-md text-headline-md text-on-surface"><%= session ? 'تعديل الدرس المباشر' : 'إضافة درس مباشر' %></h1>
  <p class="font-body-md text-body-md text-on-surface-variant">الكورس: <%= course.title %></p>

  <% if (error) { %>
  <div class="flex items-center gap-2 bg-error-container text-on-error-container p-3 rounded font-body-md text-body-md">
    <span class="material-symbols-outlined text-sm">error</span>
    <span><%= error %></span>
  </div>
  <% } %>

  <form action="<%= session ? '/live/' + session.id + '/edit' : '/live/create/' + course.id %>" method="POST" class="bg-surface-container-lowest border border-outline-variant rounded p-6 flex flex-col gap-5 max-w-2xl">
    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface" for="title">عنوان الدرس</label>
      <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" dir="rtl" id="title" name="title" value="<%= session ? session.title : '' %>" required/>
    </div>

    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface" for="description">الوصف</label>
      <textarea class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md min-h-[80px]" dir="rtl" id="description" name="description"><%= session ? session.description : '' %></textarea>
    </div>

    <div class="flex flex-col gap-1">
      <label class="font-label-lg text-label-lg text-on-surface" for="meeting_url">رابط الاجتماع <span class="text-on-surface-variant">(Zoom, Google Meet, إلخ)</span></label>
      <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" dir="ltr" id="meeting_url" name="meeting_url" placeholder="https://zoom.us/j/..." value="<%= session ? session.meeting_url : '' %>" required/>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="meeting_id">معرف الاجتماع (اختياري)</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" dir="ltr" id="meeting_id" name="meeting_id" value="<%= session ? session.meeting_id : '' %>"/>
      </div>
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="meeting_password">كلمة مرور الاجتماع (اختياري)</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" dir="ltr" id="meeting_password" name="meeting_password" value="<%= session ? session.meeting_password : '' %>"/>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="scheduled_at">تاريخ ووقت الدرس</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" id="scheduled_at" name="scheduled_at" type="datetime-local" value="<%= session ? session.scheduled_at.substring(0,16) : '' %>" required/>
      </div>
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="duration">المدة (بالدقائق)</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" id="duration" name="duration" type="number" value="<%= session ? session.duration : '60' %>"/>
      </div>
    </div>

    <% if (session) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="recording_url">رابط التسجيل (اختياري)</label>
        <input class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" dir="ltr" id="recording_url" name="recording_url" value="<%= session.recording_url %>"/>
      </div>
      <div class="flex flex-col gap-1">
        <label class="font-label-lg text-label-lg text-on-surface" for="status">الحالة</label>
        <select class="w-full bg-surface border border-outline-variant rounded py-3 px-4 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors font-body-md text-body-md" id="status" name="status">
          <option value="scheduled" <%= session.status === 'scheduled' ? 'selected' : '' %>>مجدول</option>
          <option value="live" <%= session.status === 'live' ? 'selected' : '' %>>مباشر الآن</option>
          <option value="ended" <%= session.status === 'ended' ? 'selected' : '' %>>منتهي</option>
          <option value="cancelled" <%= session.status === 'cancelled' ? 'selected' : '' %>>ملغي</option>
        </select>
      </div>
    </div>
    <% } %>

    <button type="submit" class="bg-primary-container text-on-primary font-label-lg text-label-lg py-3 px-6 rounded hover:opacity-90 transition-opacity flex items-center justify-center gap-2 self-start">
      <span class="material-symbols-outlined text-sm"><%= session ? 'save' : 'add' %></span>
      <span><%= session ? 'حفظ التغييرات' : 'إضافة الدرس' %></span>
    </button>
  </form>
</main>
<%- include('../partials/footer') %>
